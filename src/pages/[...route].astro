---
import BaseLayout from '../layouts/BaseLayout.astro';
import Listing from '../components/Listing.astro';
import {getPublished,taxonomy,href,label,type Question} from '../lib/content';
export async function getStaticPaths() {
  const questions=await getPublished();
  const paths:any[]=[];
  for(const key of ['chapters','tools','types'] as const) {
    paths.push({params:{route:key},props:{kind:'directory',key,questions}});
    for(const item of taxonomy[key]) {
      const selected=questions.filter(q=>key==='chapters'?q.data.chapterRefs.includes(item.id):key==='tools'?q.data.toolRefs.includes(item.id):q.data.type===item.id);
      const root=`/${key}/${item.id}/`;
      const filters={[key==='chapters'?'chapter':key==='tools'?'tool':'type']:item.id};
      for(let page=1;page<=(key==='chapters'&&item.id==='ch01'?1:Math.max(1,Math.ceil(selected.length/12)));page++)paths.push({params:{route:page===1?`${key}/${item.id}`:`${key}/${item.id}/page/${page}`},props:{kind:'list',key,id:item.id,questions:selected,page,root,filters}});
    }
  }
  for(let page=2;page<=Math.ceil(questions.length/12);page++)paths.push({params:{route:`questions/page/${page}`},props:{kind:'list',key:'all',questions,page,root:'/questions/',filters:{}}});
  return paths;
}
const props=Astro.props as {kind:string;key:'chapters'|'tools'|'types'|'all';id?:string;questions:Question[];page?:number;root?:string;filters?:Record<string,string>};
const {kind,key,questions,id}=props;
const title=kind==='directory'?({chapters:'課程章節',tools:'依工具查找',types:'依問題類型查找',all:'全部問題'}[key]):key==='all'?'全部問題':label(key,id!);
const chapter=key==='chapters'?taxonomy.chapters.find(c=>c.id===id):undefined;
---
<BaseLayout title={title}>
  {kind==='directory'?<><div class="page-heading"><p class="eyebrow">BROWSE Q&A</p><h1>{title}</h1><p class="lead">選擇一個分類，查看相關問題。</p></div><div class="directory-grid">{key!=='all'&&taxonomy[key].map(item=>{const count=questions.filter(q=>key==='chapters'?q.data.chapterRefs.includes(item.id):key==='tools'?q.data.toolRefs.includes(item.id):q.data.type===item.id).length;return <a href={href(`/${key}/${item.id}/`)} class="directory-card"><h2>{label(key,item.id)}</h2><span>{count} 個問題</span><span aria-hidden="true">↗</span></a>;})}</div></>:<><nav class="breadcrumb" aria-label="所在位置"><a href={href('/')}>首頁</a><span>/</span><span>{title}</span></nav><Listing questions={questions} title={title} filters={props.filters} page={props.page} root={props.root!} showAll={chapter?.id==='ch01'}/>{chapter&&chapter.id!=='ch01'&&chapter.lessons.length>0&&<section class="lesson-section"><h2>本章小節</h2>{!chapter.confirmed&&<p class="muted">目前依既有教材快照建立小節入口，正式課綱待核對。</p>}<ul class="lesson-list">{chapter.lessons.map(l=><li><a href={href(`/questions/?chapter=${chapter.id}&lesson=${l.id}`)}><span>{l.id.replace('ch','CH ').replace('-','－')}</span>{l.title}</a></li>)}</ul></section>}</>}
</BaseLayout>
