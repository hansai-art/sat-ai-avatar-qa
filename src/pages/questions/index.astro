---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Listing from '../../components/Listing.astro';
import {getPublished,taxonomy,href} from '../../lib/content';
const questions=await getPublished();
---
<BaseLayout title="搜尋與全部問題" searchFirst><Listing questions={questions} title="你卡在哪一步？" description="找到問題，點開就有解法。" root="/questions/" dynamic showAll/><div id="search-config" data-root="/questions/" data-base={import.meta.env.BASE_URL} data-taxonomy={JSON.stringify(taxonomy)} data-total={questions.length}></div><p class="search-help">找不到需要的答案？<a href={href('/chapters/')}>按章節瀏覽</a>，或<a href="https://sat.cool/course/201/comment">回課程留言提問 ↗</a></p></BaseLayout>
<script>import '../../scripts/search';</script>
