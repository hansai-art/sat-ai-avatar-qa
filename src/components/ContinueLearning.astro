---
import {getPublished,taxonomy,label,href} from '../lib/content';
const all=await getPublished();
const chapters=taxonomy.chapters.filter(c=>c.id!=='general').map(c=>({id:c.id,title:label('chapters',c.id),url:href(`/chapters/${c.id}/`),question:all.find(q=>q.data.chapterRefs.includes(c.id))})).filter(c=>c.question).map(c=>({...c,question:{title:c.question!.data.title,url:href(`/questions/${c.question!.id}/`)}}));
---
<aside id="continue-learning" class="continue-learning" hidden data-chapters={JSON.stringify(chapters)}>
  <div><a id="continue-chapter"></a><button type="button" class="text-button" id="clear-progress" aria-label="清除這台裝置的上次閱讀章節">清除</button></div>
  <a id="continue-question"></a>
</aside>
<script>
 const panel=document.querySelector<HTMLElement>('#continue-learning');
 if(panel){try{
  const chapters=JSON.parse(panel.dataset.chapters!);
  const last=chapters.find((c:any)=>c.id===localStorage.getItem('qa-last-chapter'));
  if(last){const chapter=document.querySelector<HTMLAnchorElement>('#continue-chapter')!,q=document.querySelector<HTMLAnchorElement>('#continue-question')!;
   chapter.textContent='上次看到：'+last.title;chapter.href=last.url;q.textContent='這章常見：'+last.question.title;q.href=last.question.url;panel.hidden=false;
  }
  document.querySelector('#clear-progress')!.addEventListener('click',()=>{try{localStorage.removeItem('qa-last-chapter');}catch{}panel.hidden=true;});
 }catch{}}
</script>
