---
import QuestionCard from './QuestionCard.astro';
import SearchForm from './SearchForm.astro';
import Pagination from './Pagination.astro';
import {href,type Question} from '../lib/content';
interface Props {questions:Question[];title:string;description?:string;filters?:Record<string,string>;page?:number;root:string;dynamic?:boolean;showAll?:boolean;}
const {questions,title,description,filters={},page=1,root,dynamic=false,showAll=false}=Astro.props;
const totalPages=Math.max(1,Math.ceil(questions.length/12));
---
<div class="page-heading"><p class="eyebrow">COURSE Q&A</p><h1>{title}</h1>{description&&<p class="lead">{description}</p>}</div>
<SearchForm filters={filters} full dynamic={dynamic} root={dynamic?root:'/questions/'}/>
<div class="results-toolbar"><p id={dynamic?'result-count':undefined} aria-live="polite">共 {questions.length} 個問題</p>{dynamic&&<label class="sort-control"><span id="sort-label">排序</span><select aria-labelledby="sort-label" name="sort" form="search-form"><option value="relevance">關聯程度</option><option value="updated">最近更新</option></select></label>}</div>
{dynamic&&<p id="search-notice" class="notice" hidden></p>}
{dynamic&&<p class="list-priority">學員已問優先，延伸問題排在後面。</p>}
<div id={dynamic?'static-results':undefined} class:list={{'all-questions':showAll}}>
  {questions.length?<div class="question-list">{(showAll?questions:questions.slice((page-1)*12,page*12)).map(q=><QuestionCard question={q}/>)}</div>:<div class="empty-state"><span class="empty-symbol" aria-hidden="true">Q</span><h2>這裡還沒有整理好的問答</h2><p>之後新增內容，就會出現在這個分類。</p><a href={href('/questions/')}>查看全部問題</a></div>}
  {!showAll&&<Pagination page={page} total={totalPages} root={root}/>}
</div>
{dynamic&&<div id="live-results" hidden aria-busy="false"><div id="result-list" class="question-list"></div><div id="search-message" class="empty-state" hidden></div><nav id="search-pagination" class="pagination" aria-label="搜尋結果分頁" hidden></nav></div>}
