---
import ContinueLearning from './ContinueLearning.astro';
import ScreenshotSearch from './ScreenshotSearch.astro';
import {href,taxonomy,getPublished,label} from '../lib/content';
import {matchesQuestion} from '../lib/faq.mjs';
interface Props {filters?:Record<string,string>;full?:boolean;dynamic?:boolean;root?:string;home?:boolean;}
const {filters={},full=false,dynamic=false,root='/questions/',home=false}=Astro.props;
const all=await getPublished();
const dimensions=[{key:'chapter',title:'課程章節',all:'全部章節',values:taxonomy.chapters},{key:'type',title:'問題分類',all:'全部分類',values:taxonomy.types},{key:'tool',title:'使用工具',all:'全部工具',values:taxonomy.tools}];
const counts=(key:string,value:string)=>all.filter(q=>matchesQuestion(q,{...filters,[key]:value})).length;
---
<form action={href(root)} method="get" class="search-form" id={dynamic?'search-form':undefined} role="search">
  <label class="sr-only" for="question-search">搜尋問題</label>
  <div class="search-bar"><svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input id="question-search" name="q" type="search" placeholder="輸入問題、工具名稱或錯誤訊息" autocomplete="off" maxlength="200"/><kbd class="search-kbd" aria-hidden="true">⌘K</kbd>{dynamic&&<button type="button" class="search-shot" aria-label="截圖轉文字（非 AI 判讀）" title="從截圖擷取文字，再由你確認後搜尋"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m21 16-5-5-8 8"/></svg></button>}<button class="primary-button" type="submit">搜尋</button></div>
  {home&&all.some(q=>q.id==='qa-000011')&&<nav class="quick-help" aria-label="新手與教材"><a href={href('/questions/qa-000011/')}>第一次來，從哪裡開始？</a><a href={href('/questions/qa-000015/')}>找教材與範例</a></nav>}
  {home&&<nav class="browse-entries" aria-label="選擇找答案的方式"><a href={href('/chapters/')}><span class="entry-glyph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 4h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7z"/></svg></span><span class="entry-text"><strong>依章節瀏覽</strong><span>看正在上的那一章 <span aria-hidden="true">›</span></span></span></a><a href={href('/types/')}><span class="entry-glyph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.3"/></svg></span><span class="entry-text"><strong>依問題類型找</strong><span>從卡住的情況找 <span aria-hidden="true">›</span></span></span></a></nav>}
  {home&&<ContinueLearning/>}
  {full?<>
    <details class="filter-panel"><summary>更多篩選<span id="filter-summary"></span></summary><div class="filters">
      {dimensions.map(dim=><label><span id={`${dim.key}-label`}>{dim.title}</span><select name={dim.key} aria-labelledby={`${dim.key}-label`}><option value="">{dim.all}（{all.filter(q=>matchesQuestion(q,filters,dim.key)).length} 題）</option>{dim.values.map(item=>{const count=counts(dim.key,item.id);return <option value={item.id} data-label={dim.key==='chapter'?label('chapters',item.id):'title' in item?item.title:item.name} hidden={!count&&filters[dim.key]!==item.id} disabled={!count&&filters[dim.key]!==item.id} selected={filters[dim.key]===item.id}>{dim.key==='chapter'?label('chapters',item.id):'title' in item?item.title:item.name}（{count} 題）</option>;})}</select></label>)}
    </div>{dynamic&&<ScreenshotSearch/>}</details>
    <input type="hidden" name="lesson" value={filters.lesson||''}/>
    {dynamic&&<div class="active-filters" id="active-filters" hidden><span id="active-filter-label"></span><button class="text-button" type="button" id="clear-filters">清除篩選</button></div>}
    {!dynamic&&<button class="outline-button" type="submit">套用篩選</button>}
  </>:Object.entries(filters).map(([key,value])=><input type="hidden" name={key} value={value}/>)}
  <noscript><p class="notice">全文搜尋與篩選需要 JavaScript。你仍可<a href={href('/chapters/')}>按章節瀏覽</a>或閱讀下方問題。</p></noscript>
</form>
{dynamic&&<script>
  const searchInput=document.querySelector<HTMLInputElement>('#question-search');
  const screenshotButton=document.querySelector<HTMLButtonElement>('.search-shot');
  document.addEventListener('keydown',event=>{
    if((event.metaKey||event.ctrlKey)&&event.key.toLowerCase()==='k'){
      event.preventDefault();searchInput?.focus();
    }
  });
  screenshotButton?.addEventListener('click',()=>{
    const filter=document.querySelector<HTMLDetailsElement>('.filter-panel');
    const screenshot=document.querySelector<HTMLDetailsElement>('#screenshot-search');
    if(filter)filter.open=true;if(screenshot)screenshot.open=true;
    screenshot?.scrollIntoView({block:'nearest',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
  });
</script>}
