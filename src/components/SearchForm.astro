---
import {href,taxonomy} from '../lib/content';
interface Props {filters?:Record<string,string>;full?:boolean;dynamic?:boolean;}
const {filters={},full=false,dynamic=false}=Astro.props;
---
<form action={href('/questions/')} method="get" class="search-form" id={dynamic?'search-form':undefined} role="search">
  <label class="sr-only" for="question-search">搜尋問題</label>
  <div class="search-bar"><svg aria-hidden="true" viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><input id="question-search" name="q" type="search" placeholder="輸入問題、工具名稱或錯誤訊息…" autocomplete="off" maxlength="400"/><button class="primary-button" type="submit">搜尋</button></div>
  {full?<details class="filter-panel" open><summary>篩選問題</summary><div class="filters">
    <label><span id="chapter-label">課程章節</span><select name="chapter" aria-labelledby="chapter-label"><option value="">全部章節</option>{taxonomy.chapters.map(c=><option value={c.id} selected={filters.chapter===c.id}>{c.title}</option>)}</select></label>
    <label><span id="lesson-label">課程小節</span><select name="lesson" aria-labelledby="lesson-label"><option value="">全部小節</option>{taxonomy.chapters.flatMap(c=>c.lessons.map(l=><option value={l.id} data-chapter={c.id}>{c.title}・{l.title}</option>))}</select></label>
    <label><span id="tool-label">使用工具</span><select name="tool" aria-labelledby="tool-label"><option value="">全部工具</option>{taxonomy.tools.map(t=><option value={t.id} selected={filters.tool===t.id}>{t.name}</option>)}</select></label>
    <label><span id="type-label">問題類型</span><select name="type" aria-labelledby="type-label"><option value="">全部類型</option>{taxonomy.types.map(t=><option value={t.id} selected={filters.type===t.id}>{t.name}</option>)}</select></label>
  </div></details>:Object.entries(filters).map(([key,value])=><input type="hidden" name={key} value={value}/>)}
  <noscript><p class="notice">全文搜尋需要 JavaScript。也可以使用章節、工具與下方問題列表閱讀。</p></noscript>
</form>
