---
import {href,label,type Question} from '../lib/content';
interface Props {question:Question;}
const {question:q}=Astro.props;
---
<article class="question-card" data-question-id={q.id} data-category={q.data.type}>
  <a class="question-card-link" href={href(`/questions/${q.id}/`)}>
    <h2>{q.data.title}</h2>
    <p class="card-conclusion">{q.data.summary.split(/(?<=[。！？])/u)[0]}</p>
    <span class="faq-meta"><span class="category-label" data-category={q.data.type}><span class="category-dot" aria-hidden="true"></span>{label('types',q.data.type)}</span><span aria-hidden="true">·</span>{label('chapters',q.data.chapterRefs[0])}{q.data.answerStatus==='needs-update'?' · 待更新':''}{q.data.contentOrigin==='demo'?' · 示範':''}{q.data.questionOrigin==='anticipated'?' · 延伸問題':''}</span>
  </a>
</article>
