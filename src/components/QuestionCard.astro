---
import {href,label,type Question} from '../lib/content';
import {intentLabel} from '../lib/faq.mjs';
interface Props {question:Question;}
const {question:q}=Astro.props;
---
<article class="question-card" data-question-id={q.id}>
  <details class="faq-item">
    <summary><h2>{q.data.title}</h2><span class="faq-toggle" aria-hidden="true">＋</span><span class="faq-meta">{intentLabel(q.data.intent)} · {label('chapters',q.data.chapterRefs[0])}{q.data.answerStatus==='needs-update'?' · 待更新':''}{q.data.contentOrigin==='demo'?' · 示範':''}{q.data.questionOrigin==='anticipated'?' · 延伸問題':''}</span></summary>
    <div class="faq-answer"><p class="card-summary">{q.data.summary}</p>{q.data.firstStep&&<p class="first-step"><strong>先做這一步</strong>{q.data.firstStep}</p>}<a class="answer-link" href={href(`/questions/${q.id}/`)}>查看完整解法 <span aria-hidden="true">→</span></a></div>
  </details>
</article>
