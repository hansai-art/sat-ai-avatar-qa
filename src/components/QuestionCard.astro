---
import {href,label,type Question} from '../lib/content';
interface Props {question:Question;}
const {question:q}=Astro.props;
---
<article class="question-card" data-question-id={q.id}>
  <div class="card-eyebrow"><span class:list={['origin-badge',{anticipated:q.data.questionOrigin==='anticipated'}]}>{q.data.contentOrigin==='demo'?'示範 · ':''}{q.data.questionOrigin==='anticipated'?'延伸問題':'學員已問'}</span><a href={href(`/types/${q.data.type}/`)}>{label('types',q.data.type)}</a>{q.data.answerStatus==='needs-update'&&<span class="status-badge">待更新</span>}</div>
  <h2><a href={href(`/questions/${q.id}/`)}>{q.data.title}</a></h2>
  <p class="card-summary">{q.data.summary}</p>
  {q.data.askedBy.length>0&&<p class="asker">提問：{q.data.askedBy.map((person,index)=><>{index>0?'、':''}<a href={person.sourceUrl} target="_blank" rel="noopener noreferrer">{person.name}</a></>)}</p>}
  <div class="card-meta"><div class="tag-list">{q.data.chapterRefs.map(id=><a class="tag" href={href(`/chapters/${id}/`)}>{label('chapters',id)}</a>)}{q.data.toolRefs.map(id=><a class="tag tool-tag" href={href(`/tools/${id}/`)}>{label('tools',id)}</a>)}</div><time datetime={q.data.updatedAt}>{q.data.updatedAt}</time></div>
</article>
