---
import {href,type Question} from '../lib/content';
interface Props {question:Question;related:Question[]}
const {question:q,related}=Astro.props;
---
<section class="answer-feedback" aria-labelledby="feedback-heading" data-pagefind-ignore data-id={q.id} data-qa-id={q.id} data-title={q.data.title}>
 <h2 id="feedback-heading">這題有解決你的問題嗎？</h2>
 <div class="feedback-actions"><button id="feedback-yes" type="button" class="outline-button" aria-pressed="false" disabled>有，解決了</button><button id="feedback-no" type="button" class="outline-button" aria-pressed="false" aria-controls="feedback-help" aria-expanded="false" disabled>還沒解決</button></div>
 <p id="feedback-status" role="status" class="muted"></p>
 <div id="feedback-help" hidden>
  <p class="muted">請保留本題編號 <code>{q.id}</code>，這樣工作台才能和公開問答對上。</p>
  {related.length>0&&<section id="related-questions" class="related-questions"><h3>也看看這幾題</h3><ul class="related-links">{related.map(item=><li><a href={href(`/questions/${item.id}/`)}>{item.data.title}</a></li>)}</ul></section>}
  <label for="feedback-kind">卡在哪裡</label>
  <select id="feedback-kind">
   <option value="answer-unclear">答案看不懂</option>
   <option value="steps-fail">步驟無法操作</option>
   <option value="version-diff">版本或介面不同</option>
   <option value="missing-case">沒有涵蓋我的情境</option>
   <option value="other">其他</option>
  </select>
  <label for="feedback-template">把下面內容補齊，貼到課程留言</label>
  <textarea id="feedback-template" rows="8" spellcheck="false"></textarea>
  <p class="muted">不要填入 Token、API Key 或個人資料。</p>
  <button id="copy-question" type="button" class="outline-button">複製提問格式</button>
  <a href="https://sat.cool/course/201/comment" class="outline-button" target="_blank" rel="noopener noreferrer">回報到課程留言 ↗</a>
  <p class="muted">網站不會自動送出回饋；貼到課程留言後，老師才能在工作台收錄、去重與追蹤。</p>
 </div>
 <noscript><p>還沒解決？<a href="https://sat.cool/course/201/comment">回課程留言</a>，請附上 {q.id}、本題網址、作業系統、做到第幾步及錯誤全文。</p></noscript>
</section>
<script>
 const section=document.querySelector<HTMLElement>('.answer-feedback');
 if(section){
  const yes=document.querySelector<HTMLButtonElement>('#feedback-yes')!,no=document.querySelector<HTMLButtonElement>('#feedback-no')!,help=document.querySelector<HTMLElement>('#feedback-help')!,status=document.querySelector<HTMLElement>('#feedback-status')!,text=document.querySelector<HTMLTextAreaElement>('#feedback-template')!,kind=document.querySelector<HTMLSelectElement>('#feedback-kind')!;
  yes.disabled=no.disabled=false;
  const qaId=section.dataset.qaId||'';
  const template=()=>`qa_id：${section.dataset.qaId}
問題：${section.dataset.title}
回報類型：${kind.value}
參考問答：${location.origin+location.pathname}
作業系統與版本：
工具與版本：
做到第幾步：
錯誤訊息（請遮住密鑰）：
已經試過的做法：`;
  text.value=template();
  kind.addEventListener('change',()=>{text.value=template();});
  function choose(solved:boolean){
   yes.setAttribute('aria-pressed',String(solved));no.setAttribute('aria-pressed',String(!solved));no.setAttribute('aria-expanded',String(!solved));help.hidden=solved;
   try{localStorage.setItem(`qa-feedback:${qaId}`,solved?'solved':'needs-help');}catch{}
   status.textContent=solved?'已在本頁標記解決，不會送出資料。':'先看相關題目，或複製整理好的內容貼到課程留言。';
  }
  yes.addEventListener('click',()=>choose(true));no.addEventListener('click',()=>choose(false));
  document.querySelector('#copy-question')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(text.value);status.textContent='已複製，請到課程留言貼上並送出。';}catch{text.focus();text.select();status.textContent='請手動複製已選取的提問格式。';}});
 }
</script>
