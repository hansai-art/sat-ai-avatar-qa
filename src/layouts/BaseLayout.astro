---
import '../styles/fonts.css';
import '../styles/zh-tw-typography.css';
import '../styles/global.css';
import '../styles/student-experience.css';
import '../styles/sathans-v2.css';
import '../styles/novice-roadmap.css';
import '../styles/qa-thread.css';
import {Image,getImage} from 'astro:assets';
import portrait from '../assets/brand/hans-portrait.jpg';
import {taxonomy,href,label,buildMode,getPublished} from '../lib/content';
import {getInstallSteps} from '../lib/install-steps';
const portraitIcon=await getImage({src:portrait,width:64,height:64,fit:'cover',position:'top',format:'png'});
interface Props {title:string;description?:string;noindex?:boolean;searchFirst?:boolean;activeChapter?:string;shareTitle?:string;}
const {title,description='依課程章節、工具與問題類型查找知識衛星 AI 分身課程問答。',noindex=false,searchFirst=false,activeChapter,shareTitle=title}=Astro.props;
const canonical=!noindex&&Astro.site?.protocol==='https:' ? new URL(Astro.url.pathname,Astro.site).href : undefined;
const socialSiteName='AI 分身課程問答資料庫';
const socialImage=new URL(href('/social-preview.png'),Astro.site||Astro.url.origin).href;
const current=Astro.url.pathname;
const allQuestions=await getPublished();
const chapterCounts=Object.fromEntries(taxonomy.chapters.map(c=>[c.id,allQuestions.filter(q=>q.data.chapterRefs.includes(c.id)).length]));
const hasInstallSteps=(await getInstallSteps()).length>0;
---
<!doctype html>
<html lang="zh-Hant-TW" data-pagefind-ignore={noindex?'all':undefined}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}｜AI 分身課程問答庫</title><meta name="description" content={description}/>
    <meta name="robots" content={noindex||buildMode==='demo'?'noindex, nofollow':'index, follow'}/>
    {canonical&&<link rel="canonical" href={canonical}/>}
    <meta property="og:title" content={shareTitle}/><meta property="og:site_name" content={socialSiteName}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
    {canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={socialImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:type" content="image/png"/><meta property="og:image:alt" content="AI 分身課程問答資料庫，搜尋真實學生問題並找到下一步"/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={shareTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content="AI 分身課程問答資料庫，搜尋真實學生問題並找到下一步"/>
    <meta name="theme-color" content="#ffffff" id="theme-color"/>
    <script is:inline>if(location.hostname==='sathans.pages.dev')location.replace('https://sat.aieo.tw'+location.pathname+location.search+location.hash);</script>
    <script is:inline>try{if(localStorage.getItem('qa-theme')==='dark'){document.documentElement.dataset.theme='dark';document.getElementById('theme-color').content='#0f131b';}}catch{}</script>
    <link rel="icon" type="image/png" sizes="64x64" href={portraitIcon.src}/>
  </head>
  <body class="zh-ui">
    <a class="skip-link" href="#main">跳到主要內容</a>
    {buildMode==='demo'&&<div class="demo-banner"><strong>架構預覽</strong><span>以下為示範資料，非正式課程答案</span></div>}
    <header class="site-header">
      <a class="brand" href={href('/')} aria-label="AI 分身課程問答庫首頁"><span class="brand-portrait" aria-hidden="true"><Image src={portrait} width={144} alt="" format="webp" loading="eager" decoding="async"/></span><span><span class="brand-name">知識衛星 <span class="brand-slash">/</span> AI 分身</span><span class="brand-sub">課程問答庫</span></span></a>
      <nav class="top-nav" aria-label="主選單"><a href={href('/questions/')} aria-current={current===href('/questions/')?'page':undefined}>全部問題</a><a href={href('/chapters/')} aria-current={current===href('/chapters/')?'page':undefined}>課程章節</a>{hasInstallSteps&&<a href={href('/install/')} aria-current={current===href('/install/')?'page':undefined}>安裝卡關</a>}{allQuestions.some(q=>q.id==='qa-000015')&&<a href={href('/questions/qa-000015/')}>教材與範例</a>}{allQuestions.some(q=>q.id==='qa-000011')&&<a href={href('/questions/qa-000011/')}>第一次上課</a>}<a href={href('/about/')}>使用說明</a><a class="course-link" href="https://sat.cool/classroom/201">回到課程 <span aria-hidden="true">↗</span></a></nav>
      <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" aria-label="切換深色模式"><svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span id="theme-toggle-label">深色</span></button>
      <details class="mobile-menu"><summary>選單</summary><nav aria-label="手機主選單"><a href={href('/questions/')}>全部問題</a><a href={href('/chapters/')}>課程章節</a>{hasInstallSteps&&<a href={href('/install/')}>安裝卡關地圖</a>}{allQuestions.some(q=>q.id==='qa-000015')&&<a href={href('/questions/qa-000015/')}>教材與範例</a>}{allQuestions.some(q=>q.id==='qa-000011')&&<a href={href('/questions/qa-000011/')}>第一次上課</a>}<a href={href('/about/')}>使用說明</a><a href="https://sat.cool/classroom/201">回到課程 ↗</a></nav></details>
    </header>
    {!searchFirst&&<details class="mobile-chapters"><summary>課程章節</summary><nav aria-label="手機課程章節">{taxonomy.chapters.filter(c=>chapterCounts[c.id]>0).map(c=><a href={href(`/chapters/${c.id}/`)} aria-current={activeChapter===c.id?'location':undefined}>{label('chapters',c.id)}<span>{chapterCounts[c.id]} 題</span></a>)}</nav></details>}
    <div class:list={["app-shell",{"search-first":searchFirst}]}>
      {!searchFirst&&<aside class="sidebar" aria-label="課程導覽">
        <a class:list={['nav-overview',{active:current===href('/')}]} href={href('/')}><span aria-hidden="true">⌂</span> 問答首頁</a>
        <p class="nav-label">依課程章節</p>
        <nav aria-label="章節">{taxonomy.chapters.filter(c=>chapterCounts[c.id]>0).map(c=><a class:list={['chapter-nav',{active:current===href(`/chapters/${c.id}/`)||activeChapter===c.id}]} href={href(`/chapters/${c.id}/`)} aria-current={current===href(`/chapters/${c.id}/`)?'page':activeChapter===c.id?'location':undefined}><span class="chapter-num">{c.id==='general'?'＋':String(c.order).padStart(2,'0')}</span><span>{label('chapters',c.id)}</span><span class="chapter-count">{chapterCounts[c.id]}</span></a>)}</nav>
        <div class="sidebar-divider"></div>{hasInstallSteps&&<a class:list={['nav-overview',{active:current===href('/install/')}]} href={href('/install/')}>安裝卡關地圖</a>}<a class="nav-overview" href={href('/tools/')}>依工具查找</a><a class="nav-overview" href={href('/types/')}>依問題類型查找</a>
        <p class="sidebar-note">找不到答案？<br/><a href="https://sat.cool/course/201/comment">回課程留言提問 ↗</a></p>
      </aside>}
      <main id="main" class="main-content"><slot/></main>
    </div>
    <footer class="site-footer"><span>知識衛星 AI 分身課程問答庫</span><span>內容整理：Hans 林思翰 <span aria-hidden="true">·</span> <a href={href('/about/')}>來源與更新說明</a></span></footer>
    <script is:inline>
      try{localStorage.removeItem('qa-last-chapter');}catch{}
      (function(){
        var root=document.documentElement,button=document.getElementById('theme-toggle'),label=document.getElementById('theme-toggle-label'),meta=document.getElementById('theme-color');
        if(!button)return;
        function paint(){var dark=root.dataset.theme==='dark';button.setAttribute('aria-pressed',String(dark));label.textContent=dark?'淺色':'深色';button.setAttribute('aria-label',dark?'切換淺色模式':'切換深色模式');if(meta)meta.content=dark?'#0f131b':'#ffffff';}
        button.addEventListener('click',function(){if(root.dataset.theme==='dark'){delete root.dataset.theme;try{localStorage.setItem('qa-theme','light');}catch(e){}}else{root.dataset.theme='dark';try{localStorage.setItem('qa-theme','dark');}catch(e){}}paint();});
        paint();
      })();
    </script>
  </body>
</html>
