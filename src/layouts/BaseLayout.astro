---
import '../styles/fonts.css';
import '../styles/zh-tw-typography.css';
import '../styles/global.css';
import {taxonomy,href,buildMode} from '../lib/content';
interface Props {title:string;description?:string;noindex?:boolean;searchFirst?:boolean;}
const {title,description='依課程章節、工具與問題類型查找知識衛星 AI 分身課程問答。',noindex=false,searchFirst=false}=Astro.props;
const canonical=!noindex&&Astro.site?.protocol==='https:' ? new URL(Astro.url.pathname,Astro.site).href : undefined;
const current=Astro.url.pathname;
---
<!doctype html>
<html lang="zh-Hant-TW" data-pagefind-ignore={noindex?'all':undefined}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}｜AI 分身課程問答庫</title><meta name="description" content={description}/>
    <meta name="robots" content={noindex||buildMode==='demo'?'noindex, nofollow':'index, follow'}/>
    {canonical&&<link rel="canonical" href={canonical}/>}
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>
    <meta name="theme-color" content="#184ae8"/>
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')}/>
  </head>
  <body class="zh-ui">
    <a class="skip-link" href="#main">跳到主要內容</a>
    {buildMode==='demo'&&<div class="demo-banner"><strong>架構預覽</strong><span>以下為示範資料，非正式課程答案</span></div>}
    <header class="site-header">
      <a class="brand" href={href('/')} aria-label="AI 分身課程問答庫首頁"><span class="brand-mark" aria-hidden="true">Q</span><span><span class="brand-name">知識衛星 <span class="brand-slash">/</span> AI 分身</span><span class="brand-sub">課程問答庫</span></span></a>
      <nav class="top-nav" aria-label="主選單"><a href={href('/questions/')} aria-current={current===href('/questions/')?'page':undefined}>全部問題</a><a href={href('/about/')}>使用說明</a><a class="course-link" href="https://sat.cool/course/201">回到課程 <span aria-hidden="true">↗</span></a></nav>
    </header>
    <div class:list={["app-shell",{"search-first":searchFirst}]}>
      {!searchFirst&&<aside class="sidebar" aria-label="課程導覽">
        <a class:list={['nav-overview',{active:current===href('/')}]} href={href('/')}><span aria-hidden="true">⌂</span> 問答首頁</a>
        <p class="nav-label">依課程章節</p>
        <nav aria-label="章節">{taxonomy.chapters.map(c=><a class:list={['chapter-nav',{active:current===href(`/chapters/${c.id}/`)}]} href={href(`/chapters/${c.id}/`)} aria-current={current===href(`/chapters/${c.id}/`)?'page':undefined}><span class="chapter-num">{c.id==='general'?'＋':String(c.order).padStart(2,'0')}</span><span>{c.title}</span></a>)}</nav>
        <div class="sidebar-divider"></div><a class="nav-overview" href={href('/tools/')}>依工具查找</a><a class="nav-overview" href={href('/types/')}>依問題類型查找</a>
        <p class="sidebar-note">找不到答案？<br/><a href="https://sat.cool/course/201/comment">回課程留言提問 ↗</a></p>
      </aside>}
      <main id="main" class="main-content"><slot/></main>
    </div>
    <footer class="site-footer"><span>知識衛星 AI 分身課程問答庫</span><span>內容整理：Hans 林思翰 <span aria-hidden="true">·</span> <a href={href('/about/')}>來源與更新說明</a></span></footer>
  </body>
</html>
